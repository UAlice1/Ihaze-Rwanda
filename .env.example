# OpenAI Configuration (optional - for AI-powered responses)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Database (optional - for production deployment)
# AGRI_DATABASE_URL=postgresql://user:password@host:5432/database

# Frontend origin (optional - for CORS in production)
# AGRI_FRONTEND_ORIGIN=http://your-frontend-domain.com
